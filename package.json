{
  "name": "project-tracker",
  "version": "0.0.1",
  "private": true,
  "productName": "Project Tracker",
  "description": "Analyze project folders and get an evidence-backed re-entry briefing, using Claude via the Claude CLI.",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=23.6"
  },
  "bin": {
    "ptrack": "./src/cli.ts"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-electron.mjs",
    "start": "npm run build && electron .",
    "analyze": "node src/cli.ts analyze",
    "scan": "node src/cli.ts scan",
    "render": "node src/cli.ts render",
    "typecheck": "tsc --noEmit",
    "ui": "vite"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.0",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
